# Tracked template only. Run scripts/configure_local.py after installing requirements.
# The helper creates .env with random local secrets and preserves existing values.
SECRET_KEY=
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TRUST_PROXY=False
PRIVATE_STORAGE_BACKEND=local
PRIVATE_MEDIA_ROOT=media

# Local PostgreSQL, provisioned by compose.yaml. Password is generated by the helper.
POSTGRES_DB=wefiles
POSTGRES_USER=wefiles
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
# Generated from the local values above, or provided with --database-url.
DATABASE_URL=

# Optional hosted Supabase example; URL-encode password characters.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
# On Render use PRIVATE_STORAGE_BACKEND=supabase and fill the private bucket settings.
SUPABASE_S3_ENDPOINT_URL=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=wefiles-private

# Optional separate disposable database for integration tests.
TEST_DATABASE_URL=
ALLOW_DISPOSABLE_SUPABASE_TESTS=no
