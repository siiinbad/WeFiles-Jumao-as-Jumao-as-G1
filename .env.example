# Run python scripts/configure_local.py after installing dependencies.
# Put real values in .env only. Deployment environment variables take precedence.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=

# Required: copy Connect -> Session pooler from your NEW Supabase project.
# URL-encode the password. Do not use the existing app's database.
# Example: postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_URL=
# auto detects transaction mode on port 6543. Otherwise use session.
DATABASE_POOL_MODE=auto

# Only for database-backed tests: a separate disposable Supabase project.
TEST_DATABASE_URL=

TIME_ZONE=Asia/Manila
# Set True only behind Render's trusted HTTPS proxy.
TRUST_PROXY_HTTPS=False
